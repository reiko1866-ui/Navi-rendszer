<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E12"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/racing_edition"
            android:src="@drawable/ic_checkered" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:text="@string/garage_title"
            android:textColor="@color/cockpit_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/garageBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#3A2420"
            android:text="@string/garage_back"
            android:textColor="@color/cockpit_ink" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/garage_note"
        android:textColor="@color/cockpit_muted"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/garageStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:padding="12dp">

        <View
            android:layout_width="180dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="76dp"
            android:background="@drawable/bg_garage_shadow" />

        <ImageView
            android:id="@+id/garageHero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="72dp"
            android:contentDescription="@string/garage_hero"
            android:scaleType="fitCenter" />

        <android.view.SurfaceView
            android:id="@+id/garageSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="72dp" />

        <TextView
            android:id="@+id/garageNumberBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_garage_number"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp"
            android:paddingBottom="2dp"
            android:textColor="@color/cockpit_ink"
            android:textSize="36sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/garageName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/cockpit_ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/garageLivery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/cockpit_accent_soft"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/garageRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/garage_number"
            android:textColor="@color/cockpit_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/garageMinus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#3A2420"
            android:text="−"
            android:textColor="@color/cockpit_ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/garageNumber"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:textColor="@color/cockpit_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/garagePlus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#3A2420"
            android:text="+"
            android:textColor="@color/cockpit_ink"
            android:textSize="22sp" />
    </LinearLayout>

    <Button
        android:id="@+id/garagePrototype"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#243044"
        android:text="@string/garage_prototype"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/garageUse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/cockpit_accent"
        android:text="@string/garage_use"
        android:textColor="#FFFFFF" />
</LinearLayout>
