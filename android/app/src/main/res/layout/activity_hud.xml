<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/maneuverCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/nav_blue"
        android:gravity="center_vertical"
        android:minHeight="@dimen/maneuver_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/maneuverArrow"
            android:layout_width="@dimen/arrow_size"
            android:layout_height="@dimen/arrow_size"
            android:contentDescription="@string/maneuver_arrow"
            android:src="@drawable/ic_maneuver_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stepDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/maneuver_distance"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/maneuverText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/maneuver_road"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/leftColumn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="@dimen/tools_top"
        android:layout_marginBottom="@dimen/tools_bottom"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/speedPill"
            android:elevation="4dp"
            android:layout_width="@dimen/speed_size"
            android:layout_height="@dimen/speed_size"
            android:background="@drawable/bg_speed"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/speedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/nav_ink"
                android:textSize="@dimen/speed_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed_unit"
                android:textColor="@color/nav_ink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/speedLimitSign"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_limit"
            android:gravity="center"
            android:textColor="@color/nav_ink"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/noticeStrip"
            android:layout_width="168dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/cameraTools"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/tools_top"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/tools_bottom"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/searchButton"
                android:layout_width="@dimen/tool_size"
                android:layout_height="@dimen/tool_size"
                android:background="@drawable/bg_tool"
                android:contentDescription="@string/search_reopen"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/voiceButton"
                android:layout_width="@dimen/tool_size"
                android:layout_height="@dimen/tool_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="@string/voice_on"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_voice" />

            <TextView
                android:id="@+id/orientationButton"
                android:layout_width="@dimen/tool_size"
                android:layout_height="@dimen/tool_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tool"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="É"
                android:textColor="@color/nav_blue"
                android:textSize="@dimen/tool_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeButton"
                android:layout_width="@dimen/tool_size"
                android:layout_height="@dimen/tool_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tool"
                android:gravity="center"
                android:text="☀"
                android:textColor="#E0A020"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/overviewButton"
                android:layout_width="@dimen/tool_size"
                android:layout_height="@dimen/tool_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="@string/overview"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_map" />

            <ImageButton
                android:id="@+id/recenterButton"
                android:layout_width="@dimen/tool_size"
                android:layout_height="@dimen/tool_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tool"
                android:contentDescription="@string/recenter"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_recenter" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/gutter">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="@color/nav_error"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_settings"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/fromField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/from_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textColor="@color/nav_ink" />

                <Button
                    android:id="@+id/fromSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/toField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/to_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textColor="@color/nav_ink" />

                <Button
                    android:id="@+id/toSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="160dp">

                <LinearLayout
                    android:id="@+id/results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/previewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview"
                android:textColor="@color/nav_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/previewMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/nav_ink"
                android:textSize="15sp" />

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/start_nav" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/driveCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/roadNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/nav_ink"
                    android:textSize="@dimen/road_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/remainText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#3D4440"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/stopButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="40dp"
                    android:text="@string/stop_nav" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/etaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/nav_ink"
                    android:textSize="@dimen/eta_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/planned"
                    android:textColor="#4A524C"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
