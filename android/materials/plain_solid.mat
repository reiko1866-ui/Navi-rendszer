material {
    name : PlainSolid,
    shadingModel : unlit,
    culling : none,
    featureLevel : 1,
    parameters : [
        {
            type : float4,
            name : baseColor
        },
        {
            type : sampler2d,
            name : albedo
        },
        {
            type : float,
            name : detail,
            default : 0.0
        }
    ],
    requires : [
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 texel = texture(materialParams_albedo, getUV0());
        vec3 tinted = materialParams.baseColor.rgb * texel.rgb;
        material.baseColor.rgb = mix(materialParams.baseColor.rgb, tinted, materialParams.detail);
        material.baseColor.a = materialParams.baseColor.a;
    }
}
